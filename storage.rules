rules_version = '2';

// Cloud Storage for Firebase: photos and videos in an event's gallery (events/<eventId>/<file>).
// Anyone can see them. Uploading needs an admin editor, or the organiser who proposed the
// event (their public profile owns it, see profileOwners in firestore.rules).
service firebase.storage {
  match /b/{bucket}/o {
    function isEditor() {
      let admin = /databases/(default)/documents/admins/$(request.auth.uid);
      return firestore.exists(admin) && firestore.get(admin).data.role in ['owner', 'editor'];
    }

    function isOrganiser(eventId) {
      let pid = firestore.get(/databases/(default)/documents/events/$(eventId)).data.get('organiserPublicId', '');
      return pid != '' && firestore.get(/databases/(default)/documents/profileOwners/$(pid)).data.uid == request.auth.uid;
    }

    // mp4 or webm, at most 50 MB.
    function isVideo() {
      return request.resource.contentType.matches('video/(mp4|webm)') &&
             request.resource.size <= 50 * 1024 * 1024;
    }

    // jpeg, png or webp, at most 10 MB.
    function isPhoto() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)') &&
             request.resource.size <= 10 * 1024 * 1024;
    }

    match /events/{eventId}/{file} {
      allow read: if true;
      allow create: if request.auth != null &&
                       (isVideo() || isPhoto()) &&
                       (isEditor() || isOrganiser(eventId));
      allow delete: if request.auth != null && isEditor();
    }
  }
}
